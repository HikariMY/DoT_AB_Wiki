{
  "name": "dot-abyss-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && next dev",
    "build": "npm run images && next build",
    "start": "next start",
    "images": "node scripts/generate-image-manifest.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "next": "16.4.6",
    "next-intl": "^4.16.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
